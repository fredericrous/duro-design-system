# Generated by pnpm, and reformatting it is never right: the file is a
# lockfile whose bytes are the package manager's business, and prettier's
# rewrite would show up as noise in every dependency change.
#
# It never came up under husky because that lint-staged glob was
# `*.{ts,tsx,js,jsx,json,css,md}` — no yaml. amont's prettier check covers
# .yaml/.yml too, which is how this surfaced.
pnpm-lock.yaml

# Generated registry — a pure function of the source tree, byte-compared by
# build-registry.mjs --check; prettier reflow would break that comparison.
packages/cli/registry.json
