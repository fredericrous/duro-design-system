{
  "name": "@greenharness/greenrack-ui-email",
  "version": "0.34.5",
  "description": "Token-driven, dark/light-aware email components for Duro (React Email).",
  "repository": {
    "type": "git",
    "url": "https://github.com/greenharness/greenrack",
    "directory": "packages/ui-email"
  },
  "homepage": "https://github.com/greenharness/greenrack",
  "bugs": {
    "url": "https://github.com/greenharness/greenrack/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "check:types": "test -f dist/index.d.ts && attw --pack . --profile esm-only",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@greenharness/greenrack-tokens": "workspace:^",
    "@react-email/components": "^1.0.9"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.4.5",
    "vite-plugin-dts": "^4.0.0"
  }
}
