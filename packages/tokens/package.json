{
  "name": "@duro-app/tokens",
  "version": "0.28.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fredericrous/duro-design-system",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/fredericrous/duro-design-system",
  "bugs": {
    "url": "https://github.com/fredericrous/duro-design-system/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./raw": {
      "source": "./src/raw.ts",
      "import": "./dist/raw.js",
      "types": "./src/raw.ts",
      "default": "./dist/raw.js"
    },
    "./keys": {
      "source": "./src/keys.ts",
      "import": "./dist/keys.js",
      "types": "./src/keys.ts",
      "default": "./dist/keys.js"
    },
    "./tokens/breakpoints.css": "./src/tokens/breakpoints.css.ts",
    "./tokens/colors.css": "./src/tokens/colors.css.ts",
    "./tokens/spacing.css": "./src/tokens/spacing.css.ts",
    "./tokens/typography.css": "./src/tokens/typography.css.ts",
    "./tokens/layout-spacing.css": "./src/tokens/layout-spacing.css.ts",
    "./tokens/shadows.css": "./src/tokens/shadows.css.ts",
    "./tokens/motion.css": "./src/tokens/motion.css.ts",
    "./tokens/type-presets.css": "./src/tokens/type-presets.css.ts",
    "./themes/light.css": "./src/themes/light.css.ts",
    "./themes/high-contrast.css": "./src/themes/high-contrast.css.ts",
    "./vars.css": "./dist/vars.css"
  },
  "scripts": {
    "dev": "vite build --watch",
    "prebuild": "node scripts/check-token-drift.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "postbuild": "node scripts/generate-vars-css.mjs"
  },
  "peerDependencies": {
    "react-strict-dom": "^0.0.55"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/preset-typescript": "^7.28.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-babel": "^1.5.0",
    "vite-plugin-dts": "^4.0.0"
  }
}
