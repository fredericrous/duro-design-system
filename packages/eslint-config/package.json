{
  "name": "@duro-app/eslint-config",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Shareable ESLint flat config for the Duro design system: the design-system rules and UI-library policy for React apps, on top of @aval-adr/eslint-config.",
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslint-config",
    "react-strict-dom",
    "design-system"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/fredericrous/duro-design-system",
    "directory": "packages/eslint-config"
  },
  "homepage": "https://github.com/fredericrous/duro-design-system",
  "bugs": {
    "url": "https://github.com/fredericrous/duro-design-system/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "index.d.ts"
  ],
  "main": "src/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@aval-adr/eslint-config": ">=0.16.0 <1",
    "eslint": "^9.0.0 || ^10.0.0"
  },
  "dependencies": {
    "@duro-app/eslint-plugin": "workspace:^",
    "eslint-plugin-react-hooks": "^7.0.1",
    "typescript-eslint": "^8.56.0"
  },
  "devDependencies": {
    "@aval-adr/eslint-config": "^0.16.0",
    "eslint": "^9.20.0",
    "typescript": "^5.7.0"
  }
}
