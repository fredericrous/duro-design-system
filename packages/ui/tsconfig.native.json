{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "rootDir": "src",
    "lib": ["ES2022"],
    "types": ["react-native"],
    "customConditions": ["react-native"],
    "moduleSuffixes": [".native", ""],
    "paths": {
      "react-dom": ["./src/native-guard/react-dom.d.ts"],
      "@duro-app/tokens": ["../tokens/dist/index.d.ts"]
    }
  },
  "include": ["src/index.native.ts", "src/native-guard/globals.d.ts"],
  "exclude": ["dist", "node_modules"]
}
