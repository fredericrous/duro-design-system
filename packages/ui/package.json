{
  "name": "@duro-app/ui",
  "version": "0.34.5",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fredericrous/duro-design-system",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/fredericrous/duro-design-system",
  "bugs": {
    "url": "https://github.com/fredericrous/duro-design-system/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.native.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./dist/index.css": "./dist/index.css",
    "./component-meta": "./src/components/component-meta.ts",
    "./strict.css": "./src/strict.css",
    "./reset.css": "./src/global-reset.css",
    "./table": {
      "source": "./src/table.ts",
      "import": "./dist/table.js",
      "types": "./dist/table.d.ts"
    },
    "./form": {
      "react-native": "./src/form.native.ts",
      "source": "./src/form.ts",
      "import": "./dist/form.js",
      "types": "./dist/form.d.ts"
    }
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.native.json"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@tanstack/react-table": ">=8.0.0",
    "effect": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.55.0",
    "react-native": ">=0.81.0",
    "react-native-gesture-handler": "^2.28.0",
    "react-native-reanimated": ">=4.1.0",
    "react-native-safe-area-context": "^5.6.0",
    "react-native-svg": "^15.12.0",
    "react-native-worklets": ">=0.5.0",
    "react-strict-dom": "^0.0.55"
  },
  "peerDependenciesMeta": {
    "@hookform/resolvers": {
      "optional": true
    },
    "@tanstack/react-table": {
      "optional": true
    },
    "effect": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "react-native-worklets": {
      "optional": true
    }
  },
  "dependencies": {
    "@duro-app/tokens": "workspace:^",
    "@tanstack/react-virtual": "^3.14.13",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.0",
    "@hookform/resolvers": "^5.0.0",
    "@phosphor-icons/core": "2.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "effect": "^3.0.0",
    "react-hook-form": "^7.55.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "2.28.0",
    "react-native-reanimated": "4.3.0",
    "react-native-safe-area-context": "5.6.2",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.8.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-babel": "^1.5.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "sideEffects": [
    "**/*.css",
    "./src/strict.css"
  ]
}
