{
  "name": "@duro-app/design-system",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "pnpm -r run typecheck",
    "check:types-packed": "pnpm --filter @duro-app/tokens --filter @duro-app/ui --filter @duro-app/diagrams --filter @duro-app/ui-email run check:types",
    "native:install": "pnpm install --frozen-lockfile --ignore-workspace --dir examples/native",
    "native:export": "pnpm --ignore-workspace --dir examples/native run export && node scripts/check-native-bundle.mjs",
    "typecheck:native": "pnpm --filter @duro-app/ui exec tsc --noEmit -p tsconfig.native.json",
    "lint": "pnpm --filter @duro-app/eslint-plugin run build && eslint . && node scripts/check-native-graph.mjs",
    "lint:fix": "pnpm --filter @duro-app/eslint-plugin run build && eslint . --fix",
    "duro": "duro",
    "duro:registry": "pnpm --filter @duro-app/cli run registry",
    "duro:docs": "node packages/cli/scripts/build-registry.mjs --write-docs",
    "test": "vitest --project=storybook",
    "test:unit": "vitest --project=unit",
    "prepare": "amont init && pnpm --no-sort --filter @duro-app/eslint-plugin --filter @duro-app/tokens run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@duro-app/cli": "workspace:*",
    "@duro-app/eslint-config": "workspace:^",
    "@duro-app/eslint-plugin": "workspace:*",
    "@storybook/addon-a11y": "^10.2.13",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@vitest/coverage-v8": "^4.0.18",
    "amont": "^1.49.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.58.2",
    "prettier": "^3.5.3",
    "storybook": "^10.6.3",
    "typescript": "^5.7.0",
    "typescript-language-server": "6.0.1",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.30.2+sha512.36cdc707e7b7940a988c9c1ecf88d084f8514b5c3f085f53a2e244c2921d3b2545bc20dd4ebe1fc245feec463bb298aecea7a63ed1f7680b877dc6379d8d0cb4"
}
