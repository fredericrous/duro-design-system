{
  "name": "@duro-app/design-system",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm --filter @duro-app/eslint-plugin run build && eslint .",
    "lint:fix": "pnpm --filter @duro-app/eslint-plugin run build && eslint . --fix",
    "test": "vitest --project=storybook",
    "test:unit": "vitest --project=unit",
    "prepare": "amont init"
  },
  "devDependencies": {
    "@duro-app/eslint-plugin": "workspace:*",
    "@storybook/addon-a11y": "^10.2.13",
    "@storybook/addon-docs": "^10.2.13",
    "@storybook/addon-vitest": "^10.2.13",
    "@storybook/react": "^10.2.13",
    "@storybook/react-vite": "^10.2.13",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@typescript-eslint/parser": "^8.0.0",
    "amont": "^1.5.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.20.0",
    "playwright": "^1.58.2",
    "prettier": "^3.5.3",
    "storybook": "^10.2.13",
    "typescript": "^5.7.0",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.30.2+sha512.36cdc707e7b7940a988c9c1ecf88d084f8514b5c3f085f53a2e244c2921d3b2545bc20dd4ebe1fc245feec463bb298aecea7a63ed1f7680b877dc6379d8d0cb4"
}
