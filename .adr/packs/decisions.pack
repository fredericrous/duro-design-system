keys:
  "build.toolchain-source":
    description: "Where the exact toolchain and tool versions a repository builds and checks with are decided"
  "change.deferral-record":
    description: "How a deliberate simplification is recorded, and where"
  "change.dependency-bar":
    description: "What justifies adding a third-party dependency"
  "ci.attested-skip":
    description: "When a CI step may be skipped on a verified attestation instead of running"
  "ci.presence":
    description: "Whether a repository runs continuous integration, and from when"
  "ci.system":
    description: "Which continuous-integration system runs a repository's checks"
  "ci.test-gate-stage":
    description: "Which git hook stage runs the test suite"
  "cli.conventions":
    description: "Which named body of rules defines how a first-party command-line program behaves"
  "code.functional-canon":
    description: "Which named body of rules defines how behaviour and state are modelled functionally"
  "code.paradigm":
    description: "How behaviour is composed and reused in first-party code"
  "code.practice-canon":
    description: "Which named body of rules defines well-written code"
  "data.layering":
    description: "How a data platform is layered between raw ingest and consumers"
  "forge.primary":
    description: "Which forge is authoritative for a repository"
  "guidance.generated-block":
    description: "How a tool-generated block in a tracked file is kept current, and by whom"
  "guidance.prose-canon":
